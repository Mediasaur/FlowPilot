---
const { title } = Astro.props;
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    
    <Header />
    <main class="max-w-6xl mx-auto px-6 py-12">
      <slot />
    </main>
  </body>
</html>