---

import { getMarketingPages } from '../lib/webflow';
import Layout from '../layouts/Layout.astro';

const marketingPages = await getMarketingPages();


const homeMarketingPage = marketingPages.find(
  (item) => item.fieldData.slug === 'home'
);

if (!homeMarketingPage) {
  throw new Error('Home marketing page was not found.');
}

if (!homeMarketingPage.fieldData['hero-headline']) {
  throw new Error(`Marketing page "${homeMarketingPage.fieldData.name}" is missing a headline.`);
}



---

<Layout title="FlowPilot | Home">
  <div class="text-sm font-semibold uppercase tracking-wider text-blue-700">{ homeMarketingPage.fieldData['hero-eyebrow'] }</div>
  <h1 class="mt-4 max-w-3xl text-5xl font-bold tracking-tight text-slate-900">{ homeMarketingPage.fieldData['hero-headline'] }</h1>
  <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">{ homeMarketingPage.fieldData['hero-body'] }</p>
  <div class="mt-8 flex flex-wrap gap-4">
    <a class="inline-flex items-center justify-center rounded-md bg-blue-700 px-5 py-3 font-semibold text-white hover:bg-blue-800" href={ homeMarketingPage.fieldData['primary-cta-url'] }>{ homeMarketingPage.fieldData['primary-cta-label'] }</a>
    <a class="inline-flex items-center justify-center rounded-md border border-slate-300 px-5 py-3 font-semibold text-slate-700 hover:bg-slate-50" href={ homeMarketingPage.fieldData['secondary-cta-url'] }>{ homeMarketingPage.fieldData['secondary-cta-label'] }</a>
  </div>
</Layout>
